{
  "name": "whatfees-api",
  "version": "1.0.524",
  "private": true,
  "description": "whatfees backend API (Azure Functions + Cosmos DB)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/generate-shared-contracts.mjs --check && tsc -p .",
    "clean": "rimraf dist",
    "start": "func start",
    "start:build": "npm run build && func start",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "verify": "npm run build && npm run test:runtime-protocol && npm run test",
    "verify:ci": "npm run build && npm run typecheck:tests && npm run test:runtime-protocol && npm run test:coverage",
    "test": "vitest run --config vitest.config.mjs",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage --maxWorkers=2",
    "test:runtime-protocol": "node --test test/runtime-sales-validation.test.mjs",
    "test:watch": "vitest --config vitest.config.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "~4.9.3",
    "@azure/functions": "^4.16.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
